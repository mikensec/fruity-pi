{
  "name": "fruity-pi",
  "version": "0.1.0",
  "description": "Web dashboard to run, isolate, deploy and manage many pi coding-agent instances on one machine",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikensec/fruity-pi.git"
  },
  "homepage": "https://github.com/mikensec/fruity-pi#readme",
  "bugs": {
    "url": "https://github.com/mikensec/fruity-pi/issues"
  },
  "keywords": [
    "pi",
    "pi-coding-agent",
    "ai-agents",
    "orchestration",
    "dashboard",
    "skills"
  ],
  "type": "module",
  "bin": {
    "fruity-pi": "bin/fruity-pi.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch src/cli.ts serve",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.json",
    "build:web": "vite build --config web/vite.config.ts",
    "start": "node bin/fruity-pi.js serve",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit"
  },
  "license": "MIT",
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.99.1",
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^10.1.5",
    "@fastify/websocket": "^11.3.1",
    "fastify": "^5.12.5",
    "node-pty": "^1.1.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
