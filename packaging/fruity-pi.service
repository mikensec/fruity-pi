[Unit]
Description=fruity-pi — multi-instance pi agent dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=FRUITY_PI_HOME=@STATE@
Environment=NODE_ENV=production
# Proxy / corporate CA settings written by install.sh --proxy / --ca-cert (optional).
EnvironmentFile=-@STATE@/env
WorkingDirectory=@APP@
ExecStart=@NODE@ @APP@/dist/cli.js serve
# Setting a CPU weight makes systemd enable per-service CPU fair-sharing in the user
# manager, so a busy neighbour service (OCR, builds, …) can't starve the agents.
# 100 = an equal share with every other service; raise it to prioritise fruity-pi.
CPUWeight=100
Restart=on-failure
RestartSec=3
# pi instances are children; give them time to finish on stop.
KillMode=mixed
TimeoutStopSec=30
# Hardening that doesn't get in the way of agents working in $HOME.
NoNewPrivileges=yes
PrivateTmp=yes
UMask=0077

[Install]
WantedBy=default.target
